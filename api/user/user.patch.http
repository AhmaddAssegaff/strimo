### Update Profile
PATCH {{host}}/api/v1/user/profile
Authorization: Bearer {{access-token}}
Content-Type: application/json

{
  "username": "Ahmad"
}

### Update Profile Picture webp
PATCH {{host}}/api/v1/user/profile/profile-picture
Authorization: Bearer {{access-token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="path-file.webp"
Content-Type: image/webp

< path/to/your/file.webp
--boundary--

### Update Profile Picture png
PATCH {{host}}/api/v1/user/profile/profile-picture
Authorization: Bearer {{access-token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="path-file.png"
Content-Type: image/png

< path/to/your/file.png
--boundary--

### Update Profile Picture jpeg
PATCH {{host}}/api/v1/user/profile/profile-picture
Authorization: Bearer {{access-token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="path-file. jpeg"
Content-Type: image/jpeg

< path/to/your/file.jpeg
--boundary--
