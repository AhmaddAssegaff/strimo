@videoId=98adf27d-eafe-4834-a32f-4bcf5c99122a
@uploadId=701c85a1-a5ec-4b9e-8b24-58c75f07430c

### Initiate Upload video
POST {{host}}/api/v1/uploads/initiate/{{videoId}}
Authorization: Bearer {{variables.access-token}}
Content-Type: application/json

{
  "filename": "video.mp4",
  "mimeType": "video/mp4",
  "sizeBytes": 28776080,
  "sha256Hex": "29f06acd93053f147cdf99909744aaae90007319a5e9d9102b692ac6d91f9c79"
}

### Get presign-url per chunk
GET {{host}}/api/v1/uploads/presigned-url/{{uploadId}}?chunkNumber=4
Authorization: Bearer {{variables.access-token}}

### Update etag Chunks
PATCH {{host}}/api/v1/uploads/chunks/{{uploadId}}?chunkNumber=4
Authorization: Bearer {{variables.access-token}}
Content-Type: application/json

{
  "etag": "\"af3514e54d695baf7d20596de9fdbe2e\"",
  "sha256Base64": "Nr70cKlN99N1vR9hDAhr+8xaLbecCXlwmMNgtub0LzE="
}

### post complated upload
POST {{host}}/api/v1/uploads/complete/{{uploadId}}
Authorization: Bearer {{variables.access-token}}


### check status uplod
GET {{host}}/api/v1/uploads/status/{{uploadId}}
Authorization: Bearer {{variables.access-token}}

### abort upload
DELETE {{host}}/api/v1/uploads/abort/{{uploadId}}
Authorization: Bearer {{variables.access-token}}
