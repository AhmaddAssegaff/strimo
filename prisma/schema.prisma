// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output       = "../generated/prisma"
  // moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum USER_ACCOUNTS_PROVIDER {
  google
}

enum SUBSCRIPTION_NOTIFICATION_TYPE {
  all
  none
  personalized
}

enum VIDEO_STATUS {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  FAILED
  PUBLISHED
}

enum VIDEO_VISIBILITY {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum UPLOAD_STATUS {
  PENDING
  UPLOADING
  UPLOADED
  SCANNING
  CLEAN
  INFECTED
  FAILED
}

enum UPLOAD_TYPE {
  SINGLE
  MULTIPART
}

enum CHUNK_STATUS {
  PENDING
  UPLOADED
  VERIFIED
}

enum PROCESSING_STATUS {
  STARTED
  PASSED
  FAILED
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profilePicture  String?   @map("profile_picture")
  email           String    @unique
  username        String
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  accounts      UserAccount[]
  notifications Notification[]
  channel       Channel?
  subscriptions Subscription[]
  uploads       Upload[]

  @@map("users")
}

model UserAccount {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  provider   USER_ACCOUNTS_PROVIDER
  providerId String?                @map("provider_id")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  deletedAt  DateTime?              @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("user_accounts")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @map("notification_title")
  message   String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Channel {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  title           String    @map("channel_title")
  description     String    @map("channel_description")
  avatar          String
  banner          String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  isVerified      Boolean   @default(false) @map("is_verified")
  videoCount      Int       @default(0) @map("video_count")
  subscriberCount Int       @default(0) @map("subscriber_count")

  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  videos        Video[]

  @@map("channels")
}

model Subscription {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                         @map("user_id") @db.Uuid
  channelId        String                         @map("channel_id") @db.Uuid
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  deletedAt        DateTime?                      @map("deleted_at")
  notificationType SUBSCRIPTION_NOTIFICATION_TYPE @default(all) @map("notification_type")

  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@map("subscriptions")
}

model Video {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId   String           @map("channel_id") @db.Uuid
  title       String           @map("video_title")
  description String           @map("video_description")
  duration    Int              @default(0)
  manifestUrl String?          @map("manifest_url")
  thumbnail   String?
  status      VIDEO_STATUS     @default(UPLOADING)
  visibility  VIDEO_VISIBILITY @default(PRIVATE)
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  channel Channel  @relation(fields: [channelId], references: [id])
  uploads Upload[]

  @@index([channelId])
  @@map("videos")
}

model Upload {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  videoId           String?       @map("video_id") @db.Uuid
  filename          String        @db.VarChar(512)
  sizeBytes         BigInt        @map("size_bytes")
  mimeType          String        @map("mime_type") @db.VarChar(128)
  storageKey        String?       @map("storage_key") @db.VarChar(1024)
  stagingKey        String?       @map("staging_key") @db.VarChar(1024)
  checksumSha256    String?       @map("checksum_sha256") @db.Char(64)
  status            UPLOAD_STATUS @default(PENDING)
  uploadType        UPLOAD_TYPE   @default(SINGLE) @map("upload_type")
  multipartUploadId String?       @map("multipart_upload_id") @db.VarChar(512)
  totalChunks       Int?          @map("total_chunks")
  errorMessage      String?       @map("error_message") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video            Video?                  @relation(fields: [videoId], references: [id], onDelete: SetNull)
  chunks           UploadChunk[]
  processingEvents UploadProcessingEvent[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("uploads")
}

model UploadChunk {
  id          BigInt       @id @default(autoincrement()) @map("chunk_id")
  uploadId    String       @map("upload_id") @db.Uuid
  chunkNumber Int          @map("chunk_number")
  byteOffset  BigInt       @map("byte_offset")
  sizeBytes   Int          @map("size_bytes")
  etag        String?      @db.VarChar(128)
  checksumMd5 String?      @map("checksum_md5") @db.Char(32)
  status      CHUNK_STATUS @default(PENDING)
  uploadedAt  DateTime?    @map("uploaded_at") @db.Timestamptz

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, chunkNumber])
  @@index([uploadId])
  @@map("upload_chunks")
}

model UploadProcessingEvent {
  id        BigInt            @id @default(autoincrement()) @map("event_id")
  uploadId  String            @map("upload_id") @db.Uuid
  stage     String            @db.VarChar(64)
  status    PROCESSING_STATUS
  details   Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@map("upload_processing_events")
}
