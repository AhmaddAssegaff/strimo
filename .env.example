APP_PORT=3000
APP_NODE_ENV=development

APP_GLOBAL_PREFIX=api
APP_ENABLE_VERSION=true
APP_VERSION_PREFIX=v
APP_DEFAULT_VERSION=1

SWAGGER_DOCS_URL="api/docs"

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

TYPEORM_AUTO_LOAD_ENTITIES=true
TYPEORM_SYNCHRONIZE=true #Setting synchronize: true shouldn't be used in production - otherwise you can lose production data.
