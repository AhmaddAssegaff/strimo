APP_PORT=3000
APP_NODE_ENV=development

APP_GLOBAL_PREFIX=api
APP_ENABLE_VERSION=true
APP_VERSION_PREFIX=v
APP_DEFAULT_VERSION=1

SWAGGER_DOCS_URL="api/docs"

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_MAX_RECONNECT_DELAY_MS=3000
REDIS_RECONNECT_MULTIPLIER=100

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

TYPEORM_AUTO_LOAD_ENTITIES=true
TYPEORM_SYNCHRONIZE=true #Setting synchronize: true shouldn't be used in production - otherwise you can lose production data.

MINIO_ENDPOINT=localhost
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_DASHBOARD_CONSOLE_PORT=9001

MINIO_ACCESS_KEY=$MINIO_ROOT_USER
MINIO_SECRET_KEY=$MINIO_ROOT_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=""
SMTP_FROM=your-email@gmail.com

# openssl rand -base64 32   # Use this commad for generate ACCESS & REFRESH TOKEN SECRET
AUTH_JWT_ACCESS_TOKEN_SECRET=
AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN=900 #15 minutes in seconds

AUTH_JWT_REFRESH_TOKEN_SECRET=
AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=604800 #7 days in seconds

# ==============================================================================
# opentelemetry configuration
# ==============================================================================
# see this docs
## https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/

# General SDK Configuration
OTEL_SDK_DISABLED=false                                                                            #Disable the SDK for all signals
OTEL_ENTITIES="service{service.name=my-app,service.instance.id=instance-1}[service.version=1.0.0]" #Entity information to be associated with the resource
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=1.0.0#Key-value         #pairs to be used as resource attributes
OTEL_SERVICE_NAME=porto-POS                                                                        #Sets the value of the service.name resource attribute
OTEL_LOG_LEVEL="info"                                                                              #Log level used by the SDK internal logger
OTEL_PROPAGATORS="tracecontext,baggage"                                                            #Propagators to be used as a comma-separated list
OTEL_TRACES_SAMPLER="parentbased_always_on"                                                        #Sampler to be used for traces
OTEL_TRACES_SAMPLER_ARG=""                                                                         #Value to be used as the sampler argument

# Configuration Options see : https://opentelemetry.io/docs/specs/otel/protocol/exporter/
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Insecure: Whether to enable client transport security for the exporter’s gRPC connection.
# This option only applies to OTLP/gRPC when an endpoint is provided without the http or https scheme - OTLP/HTTP always uses the scheme provided for the endpoint.
# Implementations MAY choose to not implement the insecure option if it is not required or supported by the underlying gRPC client implementation.
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_TRACES_INSECURE=false
OTEL_EXPORTER_OTLP_METRICS_INSECURE=false
OTEL_EXPORTER_OTLP_LOGS_INSECURE=false

# Certificate File: The trusted certificate to use when verifying a server’s TLS credentials. Should only be used for a secure connection.
OTEL_EXPORTER_OTLP_CERTIFICATE=
OTEL_EXPORTER_OTLP_TRACES_CERTIFICATE=
OTEL_EXPORTER_OTLP_METRICS_CERTIFICATE=
OTEL_EXPORTER_OTLP_LOGS_CERTIFICATE=

# Client key file: Clients private key to use in mTLS communication in PEM format.
OTEL_EXPORTER_OTLP_CLIENT_KEY=
OTEL_EXPORTER_OTLP_TRACES_CLIENT_KEY=
OTEL_EXPORTER_OTLP_METRICS_CLIENT_KEY=
OTEL_EXPORTER_OTLP_LOGS_CLIENT_KEY=

# Client certificate file: Client certificate/chain trust for clients private key to use in mTLS communication in PEM format.
OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=
OTEL_EXPORTER_OTLP_TRACES_CLIENT_CERTIFICATE=
OTEL_EXPORTER_OTLP_METRICS_CLIENT_CERTIFICATE=
OTEL_EXPORTER_OTLP_LOGS_CLIENT_CERTIFICATE=

# Headers: Key-value pairs to be used as headers associated with gRPC or HTTP requests. See Specifying headers for more details.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_LOGS_HEADERS=

# Compression: Compression key for supported compression types. Supported compression: gzip.
OTEL_EXPORTER_OTLP_COMPRESSION=
OTEL_EXPORTER_OTLP_TRACES_COMPRESSION=
OTEL_EXPORTER_OTLP_METRICS_COMPRESSION=
OTEL_EXPORTER_OTLP_LOGS_COMPRESSION=

# Timeout: Maximum time the OTLP exporter will wait for each batch export.
OTEL_EXPORTER_OTLP_TIMEOUT=10s
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10s
OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=10s
OTEL_EXPORTER_OTLP_LOGS_TIMEOUT=10s

# Protocol: The transport protocol. Options MUST be one of: grpc, http/protobuf, http/json. See Specify Protocol for more details.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc #The transport protocol. Options MUST be one of: grpc, http/protobuf, http/json
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=$OTEL_EXPORTER_OTLP_ENDPOINT
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=$OTEL_EXPORTER_OTLP_ENDPOINT

# Batch Span Processor
OTEL_BSP_SCHEDULE_DELAY=5000       #Delay interval (in milliseconds) between two consecutive exports
OTEL_BSP_EXPORT_TIMEOUT=30000      #Maximum allowed time (in milliseconds) to export data
OTEL_BSP_MAX_QUEUE_SIZE=2048       #Maximum queue size
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512 #Maximum batch size

# Batch LogRecord Processor
OTEL_BLRP_SCHEDULE_DELAY=5000       #Delay interval (in milliseconds) between two consecutive exports
OTEL_BLRP_EXPORT_TIMEOUT=30000      #Maximum allowed time (in milliseconds) to export data
OTEL_BLRP_MAX_QUEUE_SIZE=2048       #Maximum queue size
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512 #Maximum batch size

# Attribute Limits
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT= #Maximum allowed attribute value size
OTEL_ATTRIBUTE_COUNT_LIMIT=128     #Maximum allowed attribute count

# Span Limits
OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT= #Maximum allowed attribute value size
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=128     #Maximum allowed span attribute count
OTEL_SPAN_EVENT_COUNT_LIMIT=128         #Maximum allowed span event count
OTEL_SPAN_LINK_COUNT_LIMIT=128          #Maximum allowed span link count
OTEL_EVENT_ATTRIBUTE_COUNT_LIMIT=128    #Maximum allowed attribute per span event count
OTEL_LINK_ATTRIBUTE_COUNT_LIMIT=128     #Maximum allowed attribute per span link count

# LogRecord Limits
OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT= #Maximum allowed attribute value size
OTEL_LOGRECORD_ATTRIBUTE_COUNT_LIMIT=128     #Maximum allowed log record attribute count

# OTLP Exporter
## https://opentelemetry.io/docs/specs/otel/protocol/exporter/

# Prometheus Exporter
OTEL_EXPORTER_PROMETHEUS_HOST=localhost #OTEL_EXPORTER_PROMETHEUS_HOST
OTEL_EXPORTER_PROMETHEUS_PORT=9464      #Port used by the Prometheus exporter

# Exporter Selection
OTEL_TRACES_EXPORTER=otlp  #Trace exporter to be used
OTEL_METRICS_EXPORTER=otlp #Metrics exporter to be used
OTEL_LOGS_EXPORTER=otlp    #Logs exporter to be used

# Metrics SDK Configuration
OTEL_METRICS_EXEMPLAR_FILTER="trace_based" #Filter for which measurements can become Exemplars.

# Periodic exporting MetricReader
OTEL_METRIC_EXPORT_INTERVAL=60000 #The time interval (in milliseconds) between the start of two export attempts.
OTEL_METRIC_EXPORT_TIMEOUT=30000  #Maximum allowed time (in milliseconds) to export data.

# Declarative configuration
# OTEL_CONFIG_FILE= #The path of the configuration file used to configure the SDK. If set, the configuration in this file takes precedence over all other SDK configuration environment variables.
